# =============================================================================
# CRM — variáveis de ambiente (copie para .env.local; o .env* não vai para o Git)
#
# Tudo com prefixo VITE_ entra no pacote do navegador e fica PÚBLICO. Só entra
# aqui o que qualquer visitante pode ler. A proteção dos dados é o RLS do banco.
#
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables do
# projeto do CRM.
# =============================================================================

# Painel do Supabase: Project Settings → API Keys.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# O site público: o "Ver no site" da ficha do imóvel.
VITE_PUBLIC_SITE_URL=https://juliana-soares-site.vercel.app

# A chave pública do aviso no celular (a privada fica nos segredos das edge
# functions). Vazia: o CRM funciona, só sem o push.
VITE_VAPID_PUBLIC_KEY=

# Os segredos das integrações (uazapi, Meta, crons) NÃO entram aqui nem na
# Vercel: moram nos segredos das edge functions e no Vault. Ver supabase/README.md.
