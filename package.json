{
  "name": "juliana-soares-imoveis",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev:site": "npm run dev -w apps/site",
    "dev:crm": "npm run dev -w apps/crm",
    "build:site": "npm run build -w apps/site",
    "build:crm": "npm run build -w apps/crm",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "lint:fix": "eslint . --fix && npm run lint:fix --workspaces --if-present",
    "lint:types": "eslint --config eslint.typed.config.mjs . && npm run lint:types --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rls": "npm run test:rls -w apps/crm"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.71.1"
  }
}
